export function burstConfetti(canvas: HTMLCanvasElement) {   const ctx = canvas.getContext("2d");   if (!ctx) return;   const rect = canvas.getBoundingClientRect();   canvas.width = rect.width * window.devicePixelRatio;   canvas.height = rect.height * window.devicePixelRatio;   ctx.scale(window.devicePixelRatio, window.devicePixelRatio);   const W = rect.width, H = rect.height;   const colors = ["#1cb495", "#22d4af", "#4cf0c4", "#f0f7f3", "#a8bcb0"];   const N = 28;   const cx = W / 2, cy = H / 2;   const parts = Array.from({ length: N }, (_, i) => {     const a = (i / N) * Math.PI * 2;     const speed = 4 + Math.random() * 4;     return {       x: cx, y: cy,       vx: Math.cos(a) * speed,       vy: Math.sin(a) * speed - 1,       r: 4 + Math.random() * 4,       c: colors[i % colors.length],       life: 1,     };   });   let raf = 0;   const tick = () => {     ctx.clearRect(0, 0, W, H);     let alive = false;     for (const p of parts) {
      p.vy += 0.18;
      p.x += p.vx;
      p.y += p.vy;
      p.life -= 0.012;       if (p.life > 0) {         alive = true;         ctx.globalAlpha = Math.max(0, p.life);         ctx.fillStyle = p.c;         ctx.beginPath();         ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);         ctx.fill();       }     }     ctx.globalAlpha = 1;     if (alive) raf = requestAnimationFrame(tick);   };   raf = requestAnimationFrame(tick);   return () => cancelAnimationFrame(raf);
}
